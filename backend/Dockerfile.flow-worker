# Slim flow worker — install only connector extras needed for one flow (build-arg PIP_INSTALL).
FROM python:3.11-slim

ARG PIP_EXTRAS=

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml .
COPY sangam_mw ./sangam_mw
COPY README.md ./README.md

RUN pip install --no-cache-dir --upgrade pip hatch \
    && if [ -n "$PIP_EXTRAS" ]; then pip install --no-cache-dir -e ".[${PIP_EXTRAS}]"; else pip install --no-cache-dir -e .; fi

RUN useradd -r -s /bin/false sangam
USER sangam

ENV PYTHONUNBUFFERED=1
ENV MALLOC_ARENA_MAX=2

# Worker entrypoint (pull flow from control plane or local pack).
CMD ["sangam", "worker", "run"]
