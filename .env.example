# Copy to .env and fill in values. Never commit .env.

# Postgres: how dev startup finds the database (make dev / scripts/dev.sh / sangam db ensure)
#   auto   — use DATABASE_URL; if down and URL matches Docker defaults, start compose postgres
#   docker — always start postgres from docker-compose.yml
#   local  — only DATABASE_URL (your machine's Postgres); Docker is never started
SANGAM_POSTGRES=auto

# Default matches docker-compose.yml (postgres service on localhost:5432)
DATABASE_URL=postgresql+asyncpg://sangam:sangam@localhost:5432/sangam_mw

# Example: local Postgres (Homebrew, etc.) — set SANGAM_POSTGRES=local and adjust URL:
# DATABASE_URL=postgresql+asyncpg://myuser:mypass@localhost:5432/sangam_mw

# Generate with: make generate-key
FERNET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

JWT_SECRET=dev-secret-change-in-production
ENVIRONMENT=development
